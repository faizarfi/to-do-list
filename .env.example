# ==============================================================================
# RuangKerja — Environment Configuration Example
# Salin file ini menjadi:
#   1. frontend/.env.local  (untuk variabel NEXT_PUBLIC_*)
#   2. backend/.env         (untuk konfigurasi FastAPI)
# JANGAN pernah memasukkan secret atau password asli ke repository.
# ==============================================================================

# --- Frontend (Next.js) ---
NEXT_PUBLIC_APP_NAME=RuangKerja
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50

# --- Backend (FastAPI) ---
RUANGKERJA_ENV=development
RUANGKERJA_HOST=127.0.0.1
RUANGKERJA_PORT=8000
RUANGKERJA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUANGKERJA_MAX_UPLOAD_SIZE_MB=50
RUANGKERJA_TEMP_TTL_SECONDS=1800
# Opsional: isi jika executable tesseract tidak berada di PATH sistem
# RUANGKERJA_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

